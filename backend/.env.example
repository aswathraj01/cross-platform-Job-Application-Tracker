# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# For local LLaMA via Ollama:
# LLM_PROVIDER=local
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3
# OPENAI_API_KEY=not-needed

# Firebase
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# For production deployments (e.g. Render.com), set this instead of FIREBASE_CREDENTIALS_PATH.
# Generate with: python -c "import base64,json; print(base64.b64encode(open('serviceAccountKey.json','rb').read()).decode())"
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_API_KEY=your-firebase-web-api-key

# Server
HOST=0.0.0.0
PORT=8000
